<Window x:Class="ScreenPin.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="320"
        WindowStartupLocation="Manual">
    <!-- QQ 式右下角通知：滑入、停留、淡出；点击立即关闭 -->
    <Grid RenderTransformOrigin="0,1">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <Border Background="#EE1F1F26" CornerRadius="9" Margin="14" Padding="16,11">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.45" RenderingBias="Performance" />
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Mark" FontSize="15" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="Preview" Foreground="#C8FFFFFF" FontSize="12" Margin="24,5,2,0"
                           TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
