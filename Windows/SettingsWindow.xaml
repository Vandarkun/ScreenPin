<Window x:Class="ScreenPin.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenPin 设置"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF6F6F8">
    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="常规" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
        <CheckBox x:Name="ChkAutoStart" Content="开机自动启动 ScreenPin（进入系统托盘）" Margin="2,4" />
        <CheckBox x:Name="ChkCopyImage" Content="圈选贴图后，自动把图片复制到剪贴板" Margin="2,4" />
        <CheckBox x:Name="ChkCopyText" Content="取字识别后，自动把文字复制到剪贴板" Margin="2,4" />
        <CheckBox x:Name="ChkToast" Content="显示右下角操作通知" Margin="2,4" />

        <Separator Margin="0,14,0,10" />
        <TextBlock Text="手势" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="触发距离" VerticalAlignment="Center" Margin="2,0,14,0" />
            <Slider Grid.Column="1" x:Name="SldArm" Minimum="10" Maximum="50"
                    IsSnapToTickEnabled="True" TickFrequency="5"
                    VerticalAlignment="Center" />
        </Grid>
        <TextBlock x:Name="LblArm" FontSize="11" Foreground="#888" Margin="2,6,0,0" />

        <Separator Margin="0,14,0,10" />
        <TextBlock Text="其他" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Button x:Name="BtnLog" Content="打开日志文件" Padding="12,4" HorizontalAlignment="Left" />
        <Expander Margin="2,10,0,0" Header="使用说明" IsExpanded="False">
            <TextBlock xml:space="preserve" FontSize="12" Foreground="#555" LineHeight="22">
· 普通右键：与系统一致，正常弹出菜单，不受影响

· 按住右键画圈，或从左上角起笔画"U"（下→右→上）：
  框选区域，生成置顶贴图并复制图片

· 从右上角起笔画"U"（下→左→上）：
  识别区域内的文字并复制（识别需约 0.5 秒）

· 贴图：左键拖动、右键关闭，可同时存在多张

· Alt + 鼠标中键：切换任意窗口的置顶状态
  （托盘菜单可一次取消全部置顶）

· 托盘图标：双击 快速暂停/启用；右键 打开菜单</TextBlock>
        </Expander>
        <TextBlock Text="ScreenPin 0.1.0　·　OCR 引擎：PP-OCRv6（Apache-2.0）"
                   Foreground="#999" FontSize="11" Margin="2,12,0,0" />
    </StackPanel>
</Window>
